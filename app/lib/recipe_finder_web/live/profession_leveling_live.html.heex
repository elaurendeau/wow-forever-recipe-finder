<div class="rf-topbar" id="profession-leveling-page" phx-hook="TsmSnapshot">
  <div class="rf-topbar-left">
    <h1 class="rf-title">Profession Leveling</h1>
    <a class="rf-nav-link" href={~p"/"}>← Recipe Finder</a>
    <a class="rf-nav-link" href={~p"/writs"}>Craftsman's Writs →</a>
    <a class="rf-nav-link" href={~p"/merchant-favor"}>Merchant's Favor →</a>
  </div>
  <div class="rf-freshness">
    <%= if @captured_at do %>
      Snapshot from {Calendar.strftime(@captured_at, "%Y-%m-%d %H:%M UTC")} — saved in this browser
      <button type="button" class="rf-forget-link" phx-click="clear_snapshot">forget</button>
    <% else %>
      No data uploaded yet
    <% end %>
  </div>
  <%= if @price_snapshot && length(@price_snapshot.available_realms) > 0 do %>
    <form id="realm-form" phx-change="select_realm">
      <select
        name="realm"
        class="rf-realm-select"
        title="Recent Value prices come from this realm's own AH scans — TSM keeps history for every realm you've scanned, not just the one you play now, so pick the right one."
      >
        <option
          :for={r <- @price_snapshot.available_realms}
          value={r}
          selected={r == @price_snapshot.realm}
        >
          {r}
        </option>
      </select>
    </form>
  <% end %>
  <form id="upload-form" phx-change="validate_upload" phx-submit="process_upload">
    <div class="rf-upload-pill">
      <.live_file_input upload={@uploads.tsm_export} />
      <button type="submit">Upload</button>
    </div>
  </form>
</div>

<div class="rf-page">
  <p class="rf-writs-intro">
    The recipe to craft at each skill level, picked by one rule: <strong>never lose money</strong>,
    and among the recipes that don't, craft whichever <strong>sells fastest</strong>
    — not whichever
    is most profitable. Skill-up thresholds are Wowhead's own real per-recipe data, not Classic's
    generic formula; a recipe stops counting the moment it turns <code>green</code>, not
    <code>grey</code>
    — green's skill-up chance is low enough that switching (or a gap) beats
    grinding it out.
    <span
      class="rf-source-pill"
      title="No source has a real per-recipe skill-up probability for WoW Forever. Est. crafts, Total cost and Total sell use a commonly-cited Classic-era community formula (100% until yellow, declining to 0% at grey) applied to the real band boundaries above — an estimate, not a fact."
    >
      crafts/cost/sell are estimated
    </span>
  </p>

  <%= unless @captured_at do %>
    <div class="rf-path-hint">
      Default TSM export folder:
      <code>C:\Program Files (x86)\World of Warcraft\_forever_\Interface\AddOns\TradeSkillMaster_AppHelper</code>
      <button
        type="button"
        id="copy-tsm-path"
        class="rf-copy-btn"
        phx-hook="CopyButton"
        data-copy="C:\Program Files (x86)\World of Warcraft\_forever_\Interface\AddOns\TradeSkillMaster_AppHelper"
      >
        Copy
      </button>
    </div>
  <% end %>

  <%= if @upload_error do %>
    <div class="rf-error">{@upload_error}</div>
  <% end %>

  <div class="rf-tabs">
    <%= for {slug, label} <- professions() do %>
      <button
        type="button"
        class={["rf-tab", @active_profession == slug && "active"]}
        phx-click="select_tab"
        phx-value-slug={slug}
      >
        {label}
      </button>
    <% end %>
  </div>

  <div class="rf-side-toggle" id="price-basis-toggle">
    <span class="rf-side-toggle-label">Price &amp; cost basis</span>
    <button
      type="button"
      class={["rf-side-chip", @price_basis == :recent && "on"]}
      phx-click="set_price_basis"
      phx-value-basis="recent"
      title="TSM's realm-level Recent Value — only tracked for non-commodity items, so most raw-material reagents and recipe-item purchases will show as unknown under this basis."
    >
      DB Recent
    </button>
    <button
      type="button"
      class={["rf-side-chip", @price_basis == :region_avg && "on"]}
      phx-click="set_price_basis"
      phx-value-basis="region_avg"
      title="TSM's region-wide Region Sale Avg — tracked for every item, including commodities."
    >
      Region Sale Avg
    </button>
  </div>

  <%= if @captured_at do %>
    <div class="rf-table-wrap">
      <table class="rf-table">
        <thead>
          <tr>
            <th class="num">Skill</th>
            <th>Recipe</th>
            <th class="num">Sold/day</th>
            <th class="num">Profit/craft</th>
            <th class="num" title="Estimated — see the note above the table">Est. crafts</th>
            <th
              class="num"
              title="Estimated — includes the recipe's own one-time purchase, if it has one"
            >
              Total cost
            </th>
            <th class="num" title="Estimated — gross sale value, before the AH cut">
              Total sell
            </th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <%= for segment <- @path do %>
            <%= if segment.result do %>
              <tr>
                <td class="num">{skill_range_label(segment.from_skill, segment.to_skill)}</td>
                <td>
                  <a
                    class="rf-item-name"
                    href={wowhead_url(segment.result.pattern.crafted_item.wowhead_id)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {segment.result.pattern.name}
                  </a>
                  <div class="rf-item-tier">{to_string(segment.result.pattern.tier)}</div>
                  <span class="rf-source-pill">{to_string(segment.result.pattern.source)}</span>
                </td>
                <td class="num">{format_number(segment.result.profit_result.sold_per_day)}</td>
                <td class={[
                  "num",
                  segment.result.profit_result.net_profit_per_unit_copper &&
                    segment.result.profit_result.net_profit_per_unit_copper > 0 &&
                    "rf-profit-pos",
                  segment.result.profit_result.net_profit_per_unit_copper &&
                    segment.result.profit_result.net_profit_per_unit_copper <= 0 &&
                    "rf-profit-neg"
                ]}>
                  {format_profit(segment.result.profit_result.net_profit_per_unit_copper)}
                </td>
                <td class="num rf-muted">~{crafts_needed(segment)}</td>
                <td class="num rf-muted">
                  {format_copper(
                    LevelingResult.total_cost_copper(segment.result, crafts_needed(segment))
                  )}
                </td>
                <td class="num rf-muted">
                  {format_copper(
                    LevelingResult.total_sell_copper(segment.result, crafts_needed(segment))
                  )}
                </td>
                <td class="num">
                  <button
                    type="button"
                    class="rf-side-chip"
                    phx-click="show_shopping_list"
                    phx-value-from={segment.from_skill}
                  >
                    Shopping list
                  </button>
                </td>
              </tr>
            <% else %>
              <tr class="rf-leveling-gap">
                <td class="num">{skill_range_label(segment.from_skill, segment.to_skill)}</td>
                <td colspan="7">
                  No recipe both still gives a skill-up here and is known not to lose money.
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rf-empty">
      <h3>Upload a TSM export to see the leveling path</h3>
      <p>
        The skill ranges and recipe thresholds are real; the prices come from your own snapshot.
      </p>
    </div>
  <% end %>
</div>

<%= if @shopping_segment do %>
  <% crafts = crafts_needed(@shopping_segment) %>
  <% lines = LevelingShoppingList.build_lines(@shopping_segment.result, crafts) %>
  <div class="rf-shopping-popup">
    <div class="rf-shopping-popup-header">
      <strong>{@shopping_segment.result.pattern.name} Shopping List</strong>
      <button
        type="button"
        class="rf-shopping-popup-close"
        phx-click="close_shopping_list"
        aria-label="Close"
      >
        &times;
      </button>
    </div>
    <div>
      <strong>~{crafts}</strong>
      crafts (estimated) for skill {skill_range_label(
        @shopping_segment.from_skill,
        @shopping_segment.to_skill
      )} — {format_copper(LevelingShoppingList.total_cost_copper(lines))} total cost
    </div>
    <div class="rf-shopping-list-groups">
      <div class="rf-shopping-group">
        <%= for line <- lines do %>
          <div class="rf-shopping-list-line">
            <span>{line.display_name} x{line.quantity}</span>
            <span class="rf-muted">{format_copper(line.line_total_copper)}</span>
          </div>
        <% end %>
      </div>
    </div>
    <div class="rf-shopping-list-actions" style="justify-content: flex-end;">
      <span
        id="leveling-auctionator-copy"
        phx-hook="CopyButton"
        data-copy={
          LevelingShoppingList.to_auctionator_text(@shopping_segment.result.pattern.name, lines)
        }
      >
        <button type="button" class="rf-copy-btn">Copy for Auctionator</button>
      </span>
    </div>
  </div>
<% end %>
