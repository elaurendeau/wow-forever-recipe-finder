<div class="rf-topbar" id="writs-page" phx-hook="TsmSnapshot">
  <div class="rf-topbar-left">
    <h1 class="rf-title">Craftsman's Writ Route Optimizer</h1>
    <a class="rf-nav-link" href={~p"/"}>← Recipe Finder</a>
    <a class="rf-nav-link" href={~p"/merchant-favor"}>Merchant's Favor →</a>
    <a class="rf-nav-link" href={~p"/profession-leveling"}>Profession Leveling →</a>
  </div>
  <div class="rf-freshness">
    <%= if @captured_at do %>
      Snapshot from {Calendar.strftime(@captured_at, "%Y-%m-%d %H:%M UTC")} — saved in this browser
      <button type="button" class="rf-forget-link" phx-click="clear_snapshot">forget</button>
    <% else %>
      No data uploaded yet
    <% end %>
  </div>
  <%= if @price_snapshot && length(@price_snapshot.available_realms) > 0 do %>
    <form id="realm-form" phx-change="select_realm">
      <select
        name="realm"
        class="rf-realm-select"
        title="Recent Value prices come from this realm's own AH scans — TSM keeps history for every realm you've scanned, not just the one you play now, so pick the right one."
      >
        <option
          :for={r <- @price_snapshot.available_realms}
          value={r}
          selected={r == @price_snapshot.realm}
        >
          {r}
        </option>
      </select>
    </form>
  <% end %>
  <form id="upload-form" phx-change="validate_upload" phx-submit="process_upload">
    <div class="rf-upload-pill">
      <.live_file_input upload={@uploads.tsm_export} />
      <button type="submit">Upload</button>
    </div>
  </form>
</div>

<div class="rf-page">
  <div class="rf-writs-intro">
    Buy the writ item and its required turn-in from the Auction House, hand both in for reputation. Cost is always
    TSM's realm-level <strong>Recent Value</strong>
    for every item — never the crafting-reagent cost, even for an
    item this app also tracks as a pattern elsewhere. Horde only for now; zone/travel routing is planned next.
  </div>

  <%= if @upload_error do %>
    <div class="rf-error">{@upload_error}</div>
  <% end %>

  <% filtered = WritResultsFilter.apply(@results, @filter) %>
  <% # Every result, not just the currently filtered/visible ones — a
  # checked writ stays on the map even if a later filter change
  # would otherwise hide its row (same rule as the shopping list,
  # which also reads @results rather than filtered).
  pins = if @world_map, do: WritMapPlacement.hand_in_pins(@results, @world_map), else: []
  pin_id_by_writ_id = WritMapPlacement.pin_id_by_writ_id(pins)

  checked_pin_ids =
    MapSet.new(
      for pin <- pins, Enum.any?(pin.results, &(&1.writ.id in @selected_writ_ids)), do: pin.id
    )

  checked_pins = Enum.filter(pins, &(&1.id in checked_pin_ids)) %>
  <form id="filter-form" phx-change="filter_changed">
    <div class="rf-filterbar">
      <input
        type="text"
        name="filter[search]"
        placeholder="Search writ name..."
        value={@filter.search}
      />
      <label>
        Max cost
        <input
          type="text"
          name="filter[max_cost_copper]"
          placeholder="any"
          value={@filter.max_cost_copper}
        />
      </label>
      <label>
        Min reputation
        <input
          type="text"
          name="filter[min_reputation]"
          placeholder="any"
          value={@filter.min_reputation}
        />
      </label>
    </div>
  </form>

  <div class="rf-side-toggle" id="wm-side-toggle">
    <span class="rf-side-toggle-label">I play</span>
    <button
      :for={{param, label} <- sides()}
      type="button"
      class={["rf-side-chip", side_selected?(@filter, param) && "on"]}
      phx-click="set_side"
      phx-value-side={param}
    >
      {label}
    </button>
  </div>

  <div class="rf-stats" style="margin: 12px 0;">
    <span><strong>{length(filtered)}</strong> shown</span>
    <span><strong>{length(@results)}</strong> total writs</span>
  </div>

  <div class="rf-table-wrap">
    <table class="rf-table">
      <thead>
        <tr>
          <th></th>
          <th>Writ</th>
          <th>Profession</th>
          <th>Tier</th>
          <th>Zone</th>
          <th>Hand-in NPC</th>
          <th class={th_class(@filter, :cost)} phx-click="sort_by" phx-value-field="cost">
            Cost{sort_indicator(@filter, :cost)}
          </th>
          <th
            class={th_class(@filter, :reputation)}
            phx-click="sort_by"
            phx-value-field="reputation"
          >
            Reputation{sort_indicator(@filter, :reputation)}
          </th>
          <th
            class={th_class(@filter, :rep_per_gold)}
            phx-click="sort_by"
            phx-value-field="rep_per_gold"
            title="Total reputation divided by total cost in gold"
          >
            Rep/Gold{sort_indicator(@filter, :rep_per_gold)}
          </th>
        </tr>
      </thead>
      <tbody id="writs-table-body" phx-hook="WritRowHover">
        <%= for r <- filtered do %>
          <tr data-pin-id={Map.get(pin_id_by_writ_id, r.writ.id)}>
            <td class="rf-writ-select">
              <input
                type="checkbox"
                phx-click="toggle_writ_selection"
                phx-value-id={r.writ.id}
                checked={r.writ.id in @selected_writ_ids}
              />
              <%= if (n = selection_number(@selected_writ_ids, r.writ.id)) do %>
                <span class="rf-writ-number">{n}</span>
              <% end %>
            </td>
            <td>
              <a
                class="rf-item-name"
                href={wowhead_quest_url(r.writ.wowhead_quest_id || 0)}
                target="_blank"
                rel="noopener noreferrer"
              >
                {r.writ.name}
              </a>
              <div class="rf-item-tier">
                {r.writ.hand_in.npc_name && "at #{r.writ.hand_in.npc_name}"}
              </div>
            </td>
            <td>{Enum.map_join(r.writ.profession_slugs, " / ", &profession_label/1)}</td>
            <td><span class="rf-source-pill">{tier_label(r.writ.tier)}</span></td>
            <td class="rf-muted">{r.writ.hand_in.zone || "—"}</td>
            <td class="rf-muted">{r.writ.hand_in.npc_name || "—"}</td>
            <td class="num rf-muted">
              <%= cond do %>
                <% pending_data?(r) -> %>
                  <span
                    class="writ-pending-pill"
                    title="This writ's required item hasn't been extracted yet — not that it needs nothing."
                  >
                    awaiting data
                  </span>
                <% r.total_cost_copper == nil -> %>
                  —
                <% true -> %>
                  <span
                    class="rf-tooltip-trigger"
                    id={"writ-cost-tooltip-#{r.writ.id}"}
                    phx-hook="HoverTooltip"
                  >
                    {format_copper(r.total_cost_copper)}
                    <div class="rf-tooltip">
                      <div class="rf-tooltip-title">
                        <span class="rf-tooltip-label">Writ Cost</span>
                        <span class="rf-tooltip-total">{format_copper(r.total_cost_copper)}</span>
                      </div>
                      <div class="rf-tooltip-line">
                        <span>{r.writ.writ_item_display_name}</span>
                        <span class="rf-tooltip-price">{format_copper(r.writ_item_cost_copper)}</span>
                      </div>
                      <%= for line <- r.required_item_breakdown do %>
                        <div class="rf-tooltip-line">
                          <span>{line.display_name} x{line.quantity}</span>
                          <span class="rf-tooltip-price">{format_copper(line.line_total_copper)}</span>
                        </div>
                      <% end %>
                    </div>
                  </span>
              <% end %>
            </td>
            <td class="num">
              {format_reputation(r.total_reputation)}
              <div class="rf-item-tier">
                {Enum.map_join(
                  r.writ.reputation_rewards,
                  " / ",
                  &"#{&1.amount} #{&1.faction_display_name}"
                )}
              </div>
            </td>
            <td class="num rf-profit-pos">{format_rep_per_gold(r.rep_per_gold)}</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%= if @selected_writ_ids != [] do %>
  <button
    type="button"
    class="rf-shopping-fab"
    phx-click="toggle_shopping_list_panel"
    aria-label="Shopping list"
    title="Shopping list"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="9" cy="20" r="1" fill="#1a1206" />
      <circle cx="17" cy="20" r="1" fill="#1a1206" />
      <path
        d="M3 4h2l2.4 12.2a2 2 0 002 1.8h7.2a2 2 0 002-1.8L20 8H6"
        stroke="#1a1206"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <%= if @shopping_list_unseen? do %>
      <span class="rf-shopping-fab-badge">!</span>
    <% end %>
  </button>

  <%= if @shopping_list_open? do %>
    <% groups = WritShoppingList.build_groups(@results, @selected_writ_ids) %>
    <% all_lines = Enum.flat_map(groups, & &1.lines) %>
    <div class="rf-shopping-popup">
      <div class="rf-shopping-popup-header">
        <strong>Shopping List</strong>
        <button
          type="button"
          class="rf-shopping-popup-close"
          phx-click="toggle_shopping_list_panel"
          aria-label="Close"
        >
          &times;
        </button>
      </div>
      <div>
        <strong>{length(@selected_writ_ids)}</strong>
        writs selected —
        <strong>{format_reputation(
          WritShoppingList.total_reputation(@results, @selected_writ_ids)
        )}</strong>
        total rep, {format_copper(WritShoppingList.total_cost_copper(all_lines))} total cost
      </div>
      <div class="rf-shopping-list-groups">
        <%= for group <- groups do %>
          <div class="rf-shopping-group">
            <div class="rf-shopping-group-header">
              <span class="rf-writ-number">{group.number}</span>
              <span>{group.writ.name}</span>
            </div>
            <%= for line <- group.lines do %>
              <div class="rf-shopping-list-line">
                <span>{line.display_name} x{line.quantity}</span>
                <span class="rf-muted">{format_copper(line.line_total_copper)}</span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="rf-shopping-list-actions">
        <button type="button" class="rf-forget-link" phx-click="clear_selection">clear</button>
        <span
          id="auctionator-copy"
          phx-hook="CopyButton"
          data-copy={WritShoppingList.to_auctionator_text("WoW Forever Writs", all_lines)}
        >
          <button type="button" class="rf-copy-btn">Copy for Auctionator</button>
        </span>
      </div>
    </div>
  <% end %>
<% end %>

<%= if @world_map do %>
  <button
    type="button"
    class="rf-map-fab"
    phx-click="toggle_map_panel"
    aria-label="Writ route map"
    title="Writ route map"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M9 4L3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"
        stroke="var(--accent)"
        stroke-width="2"
        stroke-linejoin="round"
      />
      <path d="M9 4v14M15 6v14" stroke="var(--accent)" stroke-width="2" />
    </svg>
  </button>

  <%= if @map_open? do %>
    <% selected = selected_pin(pins, @selected_pin_id) %>
    <div class="rf-map-popup">
      <div class="rf-map-popup-header">
        <strong>Writ Route Map</strong>
        <button
          type="button"
          class="rf-shopping-popup-close"
          phx-click="toggle_map_panel"
          aria-label="Close"
        >
          &times;
        </button>
      </div>

      <div class="rf-map-layout">
        <div class="rf-map-card">
          <div class="rf-map-tools">
            <button
              type="button"
              phx-click={
                JS.dispatch("rf:map-show-view",
                  to: "#rf-writ-map",
                  detail: %{view_box: full_view_box()}
                )
              }
            >
              Full map
            </button>
            <button
              :for={continent <- @world_map.continents}
              type="button"
              phx-click={
                JS.dispatch("rf:map-show-view",
                  to: "#rf-writ-map",
                  detail: %{view_box: rect_view_box(continent.rect)}
                )
              }
            >
              {continent_label(continent.key)}
            </button>
          </div>
          <div class="rf-map-zoom">
            <button type="button" data-zoom="in" title="Zoom in">+</button>
            <button type="button" data-zoom="out" title="Zoom out">−</button>
          </div>
          <%= if @selected_writ_ids != [] do %>
            <div class="rf-map-total-rep">
              <strong>{format_reputation(
                WritShoppingList.total_reputation(@results, @selected_writ_ids)
              )}</strong>
              total rep if you do all of them
            </div>
          <% end %>

          <svg
            id="rf-writ-map"
            class="rf-writ-map"
            phx-hook="WritMap"
            viewBox={full_view_box()}
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-label="World map of Craftsman's Writ hand-in NPCs"
          >
            <g id="rf-map-base" phx-update="ignore">
              <path
                :for={continent <- @world_map.continents}
                class="rf-map-land"
                fill-rule="evenodd"
                d={svg_path(continent.land)}
              />
              <path
                :for={zone <- @world_map.zones}
                class="rf-map-zone"
                fill-rule="evenodd"
                d={svg_path(zone.polygons)}
              >
                <title :if={zone.name}>{zone.name}</title>
              </path>
              <text
                :for={zone <- @world_map.zones}
                :if={zone.name && zone.label}
                x={elem(zone.label, 0)}
                y={elem(zone.label, 1)}
                class="rf-map-zone-label"
              >
                {zone.name}
              </text>
            </g>
            <g id="rf-map-pins">
              <g
                :for={pin <- pins}
                id={"wm-pin-#{pin.id}"}
                class={[
                  "rf-map-pin",
                  pin.id in checked_pin_ids && "checked",
                  @selected_pin_id == pin.id && "viewing"
                ]}
                transform={"translate(#{pin.x} #{pin.y})"}
                phx-click="select_pin"
                phx-value-id={pin.id}
              >
                <title>{pin_title(pin)} · {length(pin.results)} writ(s)</title>
                <g class="rf-map-scaled">
                  <circle :if={@selected_pin_id == pin.id} r="14.4" class="rf-map-pin-ring" />
                  <circle r="9" class="rf-map-pin-dot" />
                  <text class="rf-map-pin-count">{length(pin.results)}</text>
                  <circle
                    :if={:alliance in pin.friendly_to}
                    cx="-6.75"
                    cy="-7.2"
                    r="2.9"
                    class="rf-map-faction alliance"
                  />
                  <circle
                    :if={:horde in pin.friendly_to}
                    cx="6.75"
                    cy="-7.2"
                    r="2.9"
                    class="rf-map-faction horde"
                  />
                </g>
              </g>
            </g>
          </svg>
        </div>

        <div class="rf-map-panel">
          <%= if selected do %>
            <div class="rf-map-panel-head">
              <button type="button" class="rf-forget-link" phx-click="clear_pin">← Checked writs</button>
              <h3>{pin_title(selected)}</h3>
              <div class="rf-muted">
                {selected.zone}
                <span
                  id={"waypoint-copy-#{selected.id}"}
                  phx-hook="CopyButton"
                  data-copy={WritMapPlacement.waypoint_command(selected)}
                  title="Copy waypoint (TomTom)"
                >
                  <button type="button" class="rf-copy-btn">{WritMapPlacement.waypoint_command(
                    selected
                  )}</button>
                </span>
              </div>
            </div>
            <div class="rf-map-panel-list">
              <div :for={r <- selected.results} class="rf-map-panel-writ">{r.writ.name}</div>
            </div>
          <% else %>
            <div class="rf-map-panel-head">
              <h3>{length(checked_pins)} checked writ(s) on the map</h3>
              <%= if @selected_writ_ids != [] do %>
                <div>
                  <strong>{format_reputation(
                    WritShoppingList.total_reputation(@results, @selected_writ_ids)
                  )}</strong>
                  total rep if you do all of them
                </div>
              <% end %>
              <div class="rf-muted">
                <%= if checked_pins == [] do %>
                  Check a writ's row in the table (or hover one) to see where it's turned in.
                <% else %>
                  Click a pin to see its writs.
                <% end %>
              </div>
            </div>
            <div class="rf-map-panel-list">
              <div
                :for={pin <- checked_pins}
                class="rf-map-panel-row"
                phx-click="select_pin"
                phx-value-id={pin.id}
              >
                <strong>{pin_title(pin)}</strong>
                <span class="rf-muted">{pin.zone} · {length(pin.results)} writ(s)</span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
